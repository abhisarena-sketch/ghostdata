{
  "name": "@workfonic/dataghost-playground",
  "version": "0.1.0",
  "private": true,
  "description": "Browser playground for DataGhost. Runs the real engine locally; nothing is uploaded.",
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "NEXT_TELEMETRY_DISABLED=1 npx --yes serve@14.2.4 out",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.1.2",
    "@radix-ui/react-tabs": "1.1.22",
    "@workfonic/dataghost": "0.1.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.468.0",
    "next": "15.5.29",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "tailwind-merge": "2.6.0"
  },
  "devDependencies": {
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "autoprefixer": "10.4.20",
    "postcss": "8.5.33",
    "tailwindcss": "3.4.19"
  }
}
