{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "paths": {
      "@workfonic/dataghost-generators": ["./packages/generators/src/index.ts"],
      "@workfonic/dataghost-relationships": ["./packages/relationships/src/index.ts"],
      "@workfonic/dataghost-privacy": ["./packages/privacy/src/index.ts"],
      "@workfonic/dataghost-cli": ["./packages/cli/src/index.ts"],
      "@workfonic/dataghost": ["./packages/core/src/index.ts"]
    }
  },
  "include": ["packages/*/test/**/*.ts", "tests/**/*.ts", "vitest.config.ts"]
}
